<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	android:installLocation="internalOnly"
	android:versionCode="23"
	android:versionName="1.5b" >

	<uses-permission android:name="android.permission.INTERNET" />
	<!--
	    Scoped storage: on API 29+ these are ignored, and the app falls back to
	    app-specific external storage. See Storage.getDroidsoundDir().
	-->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="28" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
		android:maxSdkVersion="32" />
	<!-- Full filesystem browsing from the "Filesystem" browser entry. API 30+. -->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
	<!-- Library access for reading chip tunes from shared collections. -->
	<uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
	<uses-permission android:name="android.permission.READ_PHONE_STATE" />
	<uses-permission android:name="android.permission.WRITE_SETTINGS" />
	<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!-- PlayerService.startForeground() requires these from API 34 on. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<!-- Without this the playback notification is silently dropped on API 33+. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


	<application
		android:name="com.ssb.droidsound.DroidSoundApplication"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:theme="@android:style/Theme.NoTitleBar" >
		<activity
			android:name="com.ssb.droidsound.PlayerActivity"
			android:label="@string/app_name"
			android:launchMode="singleTask"
			android:exported="true"
			android:enableOnBackInvokedCallback="false" >
			<intent-filter>
				<action android:name="android.intent.action.SEARCH" />
			</intent-filter>

			<meta-data
				android:name="android.app.searchable"
				android:resource="@xml/searchable" />

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data android:scheme="http" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:mimeType="audio/prs.sid" />
				<data android:mimeType="audio/x-sid" />
				<data android:mimeType="audio/x-mod" />
				<data android:mimeType="audio/x-s3m" />
				<data android:mimeType="audio/x-xm" />
				<data android:mimeType="audio/x-it" />
				<data android:mimeType="audio/x-mpegurl" />
				<data android:mimeType="audio/x-scpls" />
				<data android:mimeType="audio/x-gbs" />
				<data android:mimeType="audio/x-nsf" />
				<data android:mimeType="audio/x-nsfe" />
				<data android:mimeType="audio/x-spc" />
				<data android:mimeType="audio/x-gym" />
				<data android:mimeType="audio/x-ay" />
				<data android:mimeType="audio/x-vgm" />
				<data android:mimeType="audio/x-vgz" />
				<data android:mimeType="application/x-prg" />
			</intent-filter>
			
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />

				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />

				<data android:scheme="http" />
				<data android:scheme="file" />
				<data android:mimeType="*/*" />
				<data android:pathPattern=".*\\.mod" />
				<data android:pathPattern=".*\\..*\\.mod" />
				<data android:pathPattern=".*mod\\..*" />
				<data android:pathPattern=".*\\.gbs" />
				<data android:pathPattern=".*\\..*\\.gbs" />
				<data android:pathPattern=".*\\.sid" />
				<data android:pathPattern=".*\\..*\\.sid" />
				<data android:pathPattern=".*\\.spc" />
				<data android:pathPattern=".*\\..*\\.spc" />
				<data android:pathPattern=".*\\.nsf" />
				<data android:pathPattern=".*\\..*\\.nsf" />
				<data android:pathPattern=".*\\.nsfe" />
				<data android:pathPattern=".*\\..*\\.nsfe" />
				<data android:pathPattern=".*\\.rsn" />
				<data android:pathPattern=".*\\..*\\.rsn" />
				<data android:pathPattern=".*\\.psf" />
				<data android:pathPattern=".*\\..*\\.psf" />
				<data android:pathPattern=".*\\.xm" />
				<data android:pathPattern=".*\\..*\\.xm" />
				<data android:pathPattern=".*\\.m3u" />
				<data android:pathPattern=".*\\..*\\.m3u" />
				<data android:host="*" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:scheme="file" />
				<data android:mimeType="application/zip" />
			</intent-filter>
		</activity>

		<receiver
			android:name="com.ssb.droidsound.service.RemoteControlReceiver"
			android:exported="false" >
			<intent-filter>
				<action android:name="android.intent.action.MEDIA_BUTTON" />
			</intent-filter>
		</receiver>
		
		<service
			android:name="com.ssb.droidsound.service.PlayerService"
			android:exported="false"
			android:foregroundServiceType="mediaPlayback" />

		<!--
		    SettingsActivity hosts a PreferenceFragmentCompat, which needs the
		    preferenceTheme overlay supplied by SettingsTheme.
		-->
		<activity
			android:name="com.ssb.droidsound.SettingsActivity"
			android:theme="@style/SettingsTheme" />
		<activity android:name="com.ssb.droidsound.HelpActivity" />

		<!-- provider android:name="com.ssb.droidsound.provider.SongProvider" android:authorities="com.ssb.droidsound.provider" / -->

		<meta-data
			android:name="android.app.default_searchable"
			android:value="com.ssb.droidsound.PlayerActivity" />
	</application>

</manifest>
