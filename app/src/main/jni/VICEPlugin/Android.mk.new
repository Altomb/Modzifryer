LOCAL_CFLAGS += -fcommon -Wno-implicit-function-declaration -Wno-implicit-int -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-return-type -Wno-deprecated-non-prototype -Wno-pointer-sign -Wno-format -Wno-user-defined-warnings -DLITTLE_ENDIAN=1 -std=c++14 -fpermissive -fcommon -w -Wno-register -Wno-deprecated-non-prototype -Wno-narrowing
LOCAL_CPPFLAGS += -DLITTLE_ENDIAN=1 -std=c++14 -fpermissive -fcommon -w -Wno-register -Wno-narrowing
LOCAL_C_INCLUDES += $(LOCAL_PATH) $(LOCAL_PATH)/vice $(LOCAL_PATH)/vice/monitor $(LOCAL_PATH)/vice/arch/shared $(LOCAL_PATH)/vice/arch/headless

LOCAL_STATIC_LIBRARIES := resid
include $(BUILD_SHARED_LIBRARY)
