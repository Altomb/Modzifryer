LOCAL_PATH := $(call my-dir)
include $(CLEAR_VARS)
LOCAL_MODULE := resid
LOCAL_CFLAGS := $(MY_CFLAGS) -ffast-math -fno-exceptions

MY_RESID_FILES = $(wildcard $(LOCAL_PATH)/vice/resid/*.cc)
LOCAL_SRC_FILES := $(MY_RESID_FILES:$(LOCAL_PATH)/%=%)
include $(BUILD_STATIC_LIBRARY)

include $(CLEAR_VARS)
LOCAL_MODULE := vice
